---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import CategoryCarousel from '../../components/CategoryCarousel.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export function slugifyCategory(category: string): string {
	return category
		.toLowerCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const categoryMap = new Map<string, { name: string; slug: string; posts: CollectionEntry<'blog'>[] }>();

	const PREDEFINED = [
		{ name: 'Bricolaje y Herramientas', slug: 'bricolaje-y-herramientas' },
		{ name: 'Informática', slug: 'informatica' },
		{ name: 'Productos para Mascotas', slug: 'productos-para-mascotas' },
		{ name: 'Mascotas', slug: 'mascotas' },
		{ name: 'Hogar y Cocina', slug: 'hogar-y-cocina' },
		{ name: 'Deportes y Aire Libre', slug: 'deportes-y-aire-libre' },
		{ name: 'Cuidado Personal', slug: 'cuidado-personal' },
		{ name: 'Salud y Cuidado Personal', slug: 'salud-y-cuidado-personal' },
		{ name: 'Consejos', slug: 'consejos' },
	];

	for (const def of PREDEFINED) {
		let catPosts: CollectionEntry<'blog'>[] = [];
		if (def.slug === 'consejos') {
			catPosts = posts.filter((post) => {
				const s = slugifyCategory(post.data.category || 'General');
				return s !== 'noticias' && s !== 'economia' && s !== 'deportes' && s !== 'salud';
			});
		} else {
			catPosts = posts.filter((post) => slugifyCategory(post.data.category || 'General') === def.slug);
		}

		categoryMap.set(def.slug, {
			name: def.name,
			slug: def.slug,
			posts: catPosts,
		});
	}

	for (const post of posts) {
		const rawCat = post.data.category || 'General';
		const postSlug = slugifyCategory(rawCat);
		if (!categoryMap.has(postSlug)) {
			categoryMap.set(postSlug, {
				name: rawCat,
				slug: postSlug,
				posts: posts.filter((p) => slugifyCategory(p.data.category || 'General') === postSlug),
			});
		}
	}

	const allCategories = Array.from(categoryMap.values())
		.filter((c) => c.posts.length > 0)
		.map((c) => ({
			name: c.name,
			slug: c.slug,
			count: c.posts.length,
		}));

	return Array.from(categoryMap.values()).map(({ name, slug, posts: catPosts }) => ({
		params: { categoria: slug },
		props: {
			categoryName: name,
			categorySlug: slug,
			posts: catPosts.sort(
				(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
			),
			allCategories,
		},
	}));
}

interface Props {
	categoryName: string;
	categorySlug: string;
	posts: CollectionEntry<'blog'>[];
	allCategories: { name: string; slug: string; count: number }[];
}

const { categoryName, categorySlug, posts, allCategories } = Astro.props;
const { categoria = categorySlug } = Astro.params;
---

<BaseLayout
	title={`${categoryName} | Guías y Comparativas en ${SITE_TITLE}`}
	description={`Descubre las mejores recomendaciones, comparativas independientes y análisis sobre ${categoryName} en ${SITE_TITLE}.`}
>
	<main class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-white">
		<!-- CABECERA DE CATEGORÍA -->
		<header class="text-center max-w-3xl mx-auto mb-10">
			<span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-400/15 text-teal-400 border border-teal-400/30 mb-4">
				Categoría • {categoryName}
			</span>
			<h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
				{categoryName}
			</h1>
			<p class="text-gray-400 text-base sm:text-lg leading-relaxed">
				{
					categorySlug === 'consejos'
						? 'Guías de compra, análisis de productos y recomendaciones prácticas para elegir con criterio.'
						: `Todas las guías prácticas, análisis de producto y recomendaciones objetivas sobre ${categoryName.toLowerCase()}.`
				}
			</p>
		</header>

		<CategoryCarousel category={categoria} />

		<!-- NAVEGACIÓN ENTRE CATEGORÍAS -->
		<nav class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-12 pb-6 border-b border-white/10" aria-label="Temáticas disponibles">
			<a href="/" class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold bg-white/5 hover:bg-teal-400/15 hover:text-teal-400 border border-white/10 transition-colors">
				Todas
			</a>
			{
				allCategories.map((cat) => (
					<a
						href={`/categoria/${cat.slug}`}
						class:list={[
							'px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all border',
							cat.slug === categorySlug
								? 'bg-teal-400 text-gray-950 font-bold border-teal-400 shadow-md shadow-teal-500/20'
								: 'bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 border-white/10'
						]}
					>
						<span>{cat.name}</span>
						<span class="opacity-70 ml-1 text-[11px]">({cat.count})</span>
					</a>
				))
			}
		</nav>

		<!-- GRID DE ARTÍCULOS EN GLASSMORPHISM -->
		{
			posts.length > 0 ? (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{
						posts.map((post) => (
							<a
								href={`/blog/${(post as any).slug || post.id}/`}
								class="group bg-white/[0.03] hover:bg-white/[0.06] backdrop-blur-md rounded-3xl overflow-hidden border border-white/10 hover:border-teal-500/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_-10px_rgba(0,0,0,0.6)] flex flex-col"
							>
								<div class="relative overflow-hidden h-52 bg-black/40">
									{post.data.heroImage && (
										<img
											src={post.data.heroImage}
											alt={post.data.title}
											class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
											loading="lazy"
										/>
									)}
									<div class="absolute top-3 left-3 bg-gray-950/80 backdrop-blur-md px-3.5 py-1 rounded-full border border-white/15 text-xs font-bold text-teal-400 uppercase tracking-wide">
										{categoryName}
									</div>
									<div class="absolute inset-0 bg-gradient-to-t from-gray-950/60 via-transparent to-transparent"></div>
								</div>
								
								<div class="p-6 sm:p-7 flex-1 flex flex-col">
									<div class="flex items-center gap-1.5 text-amber-400 text-xs mb-2.5">
										<span>★★★★★</span>
										<span class="text-gray-400 font-medium ml-1">(Guía Verificada)</span>
									</div>

									<h2 class="text-lg sm:text-xl font-bold text-white mb-2.5 leading-snug group-hover:text-teal-300 transition-colors line-clamp-2">
										{post.data.title}
									</h2>

									<p class="text-gray-400 text-sm mb-6 flex-1 line-clamp-3 leading-relaxed">
										{post.data.description}
									</p>

									<div class="mt-auto w-full bg-gradient-to-r from-orange-500 to-amber-500 group-hover:from-orange-400 group-hover:to-amber-400 text-white text-center font-bold py-3 px-4 rounded-xl shadow-md shadow-orange-500/20 transition-all duration-300 flex items-center justify-center gap-2 text-sm">
										<span>Ver Análisis y Precio</span>
										<svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
										</svg>
									</div>
								</div>
							</a>
						))
					}
				</div>
			) : (
				<div class="text-center py-16 px-6 bg-white/[0.03] backdrop-blur-md rounded-3xl border border-white/10 max-w-xl mx-auto my-12 shadow-xl">
					<span class="inline-block p-4 rounded-full bg-white/5 border border-white/10 text-4xl mb-4">✍️</span>
					<h2 class="text-2xl font-bold text-white mb-3">Próximamente nuevos análisis</h2>
					<p class="text-gray-400 text-sm sm:text-base leading-relaxed mb-6">
						El autopiloto está redactando las mejores comparativas y análisis de compra para la categoría {categoryName}.
					</p>
					<a href="/" class="inline-flex items-center gap-2 px-7 py-3 rounded-full bg-teal-400 text-gray-950 font-extrabold text-sm hover:bg-teal-300 transition-all no-underline shadow-lg shadow-teal-500/20">
						← Explorar todas las categorías
					</a>
				</div>
			)
		}
	</main>
</BaseLayout>
