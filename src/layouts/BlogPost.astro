---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AmazonCTA from '../components/AmazonCTA.astro';
import AdSenseRotator from '../components/AdSenseRotator.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticulosRelacionados from '../components/ArticulosRelacionados.astro';

type Props = Partial<CollectionEntry<'blog'>['data']> & {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: any;
	keyword?: string;
	category?: string;
	isBlogPost?: boolean;
	slug?: string;
	producto_afiliado?: string;
	texto_boton?: string;
};

const { title, description, pubDate, updatedDate, heroImage, keyword, category, slug, producto_afiliado, texto_boton } = Astro.props;
const currentSlug = slug || Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '') || '';
const isBlogPost = Astro.props.isBlogPost !== false && !Astro.url.pathname.includes('/about');
const esNoticia = category?.toLowerCase().trim() === 'noticias';
const mostrarAfiliacion = isBlogPost;

// Afiliación Amazon: variable accesible en Astro con prefijo PUBLIC_
const AMAZON_AFFILIATE_TAG =
	import.meta.env.PUBLIC_AMAZON_AFFILIATE_TAG ||
	import.meta.env.AMAZON_AFFILIATE_TAG ||
	'tu-tag-21';

// Limpieza agresiva de keywords para búsquedas directas en Amazon
function limpiarKeywordParaAmazon(input: string): string {
	if (!input) return '';
	let str = input.toLowerCase().trim();
	// Quitar expresiones compuestas que confunden a Amazon
	str = str.replace(/\bsegunda\s+mano\b/gi, ' ');
	// Quitar caracteres especiales y puntuación
	str = str.replace(/[^\p{L}\p{N}\s]/gu, ' ');

	// Preposiciones, artículos, conectores y términos comerciales a eliminar
	const stopWords = new Set([
		// Preposiciones, artículos y conectores
		'a', 'al', 'con', 'de', 'del', 'desde', 'en', 'entre', 'hacia', 'hasta',
		'para', 'por', 'sobre', 'tras', 'y', 'e', 'o', 'u', 'ni', 'que',
		'el', 'la', 'los', 'las', 'un', 'una', 'unos', 'unas', 'lo',
		// Ruido comercial y términos que dispersan el buscador de Amazon
		'oferta', 'ofertas', 'comprar', 'mejor', 'mejores', 'precio', 'precios',
		'barato', 'baratos', 'barata', 'baratas', 'economico', 'economicos', 'economica', 'economicas',
		'calidad', 'segunda', 'mano', 'usado', 'usados', 'usada', 'usadas',
		'opinion', 'opiniones', 'guia', 'guias', 'review', 'reviews',
		'marca', 'marcas', 'tipo', 'tipos', 'online', 'descuento', 'descuentos',
		'rebaja', 'rebajas', 'catalogo', 'venta', 'donde', 'como'
	]);

	const stripAccents = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

	const words = str.split(/\s+/).filter(Boolean);
	const filtered = words.filter((w) => !stopWords.has(stripAccents(w)));

	return filtered.join(' ') || str;
}

const base = producto_afiliado || keyword || title;
const palabraClaveLimpia = limpiarKeywordParaAmazon(base);
const amazonUrl = `https://www.amazon.es/s?k=${encodeURIComponent(palabraClaveLimpia)}&tag=${encodeURIComponent(AMAZON_AFFILIATE_TAG)}`;

// SEO Fase 3: URLs absolutas y marcado estructurado Schema.org NewsArticle
const siteBase = Astro.site ? Astro.site : new URL('https://somos-recomienda.vercel.app');

function getAbsoluteImageUrl(img?: any): string {
	if (!img) {
		return new URL('/favicon.svg', siteBase).toString();
	}
	const src = typeof img === 'string' ? img : img.src || '';
	if (!src) {
		return new URL('/favicon.svg', siteBase).toString();
	}
	if (src.startsWith('http://') || src.startsWith('https://')) {
		return src;
	}
	const normalizedPath = src.startsWith('/') ? src : `/${src}`;
	return new URL(normalizedPath, siteBase).toString();
}

const absoluteHeroImageUrl = getAbsoluteImageUrl(heroImage);

// Formateo seguro ISO 8601 de fechas para Schema.org
const toISOStringSafe = (d: any): string => {
	try {
		const parsed = d instanceof Date ? d : new Date(d);
		return isNaN(parsed.getTime()) ? new Date().toISOString() : parsed.toISOString();
	} catch {
		return new Date().toISOString();
	}
};

const datePublishedISO = toISOStringSafe(pubDate);
const dateModifiedISO = updatedDate ? toISOStringSafe(updatedDate) : datePublishedISO;

const newsArticleSchema = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	image: [absoluteHeroImageUrl],
	datePublished: datePublishedISO,
	dateModified: dateModifiedISO,
	author: {
		'@type': 'Organization',
		name: 'Redacción Recomendación',
	},
	publisher: {
		'@type': 'Organization',
		name: 'Recomendación',
		logo: {
			'@type': 'ImageObject',
			url: new URL('/favicon.svg', siteBase).toString(),
		},
	},
};
---

<Layout title={title} description={description} showRails={isBlogPost} disableDefaultOg={true}>
	<Fragment slot="head">
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="article" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteHeroImageUrl} />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteHeroImageUrl} />

		<!-- Marcado de Datos Estructurados: Schema.org NewsArticle (Google Top Stories & Discover) -->
		<script type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />
	</Fragment>

	<Fragment slot="hero-section">
		<header class="article-hero">
			{isBlogPost && (
				<div class="breadcrumbs-container">
					<Breadcrumbs categoria={category} titulo={title} />
				</div>
			)}
			{heroImage && (
				<div class="hero-image-wrap">
					<img src={heroImage} alt={title} class="featured-image" loading="eager" />
				</div>
			)}

			<div class="hero-meta">
				<h1 class="article-title">{title}</h1>

				{isBlogPost && (
					<div class="publication-date-wrapper">
						<span class="publication-date-pill">
							<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
							</svg>
							<span>Publicado el: <strong><FormattedDate date={pubDate} /></strong></span>
							{updatedDate && (
								<span class="last-updated-on">
									(Actualizado el <FormattedDate date={updatedDate} />)
								</span>
							)}
						</span>
					</div>
				)}

				{isBlogPost && (
					<div class="meta-badges">
						{category && (
							<a
								class:list={['category-badge', { 'badge-noticias': esNoticia }]}
								href={`/categoria/${category.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}`}
							>
								{category}
							</a>
						)}
						<span class="author">Autor: Redacción Recomendación</span>
						{esNoticia ? (
							<span class="badge badge-noticias">🔴 Actualidad</span>
						) : (
							<span class="badge">⚡ Lectura rápida</span>
						)}
					</div>
				)}
			</div>

			{mostrarAfiliacion && (
				<div class="hero-cta-wrap">
					<AmazonCTA
						id="cta-hero"
						href={amazonUrl}
						producto={palabraClaveLimpia}
						texto={texto_boton}
						store="amazon"
						slug={currentSlug}
						position="intro"
					/>
				</div>
			)}
		</header>
	</Fragment>

	<article class="article-content">
		<div class="prose">
			<AdSenseRotator position="in-article" id="ad-rotator-in-article" />
			<slot />
			{mostrarAfiliacion && (
				<div class="article-cta-block" id="cta-faq-wrap">
					<AmazonCTA
						id="cta-faq"
						href={amazonUrl}
						producto={palabraClaveLimpia}
						texto={texto_boton}
						store="amazon"
						slug={currentSlug}
						position="conclusion"
					/>
				</div>
			)}
			{isBlogPost && (
				<div class="article-author-block">
					<AuthorBox />
				</div>
			)}
			{isBlogPost && (
				<div class="article-related-block">
					<ArticulosRelacionados categoria={category} currentSlug={currentSlug} />
				</div>
			)}
			<div class="article-adsense-bottom-block">
				<AdSenseRotator position="bottom" id="ad-rotator-bottom" />
			</div>
			<div class="back-wrap">
				<a class="back-btn" href="/">
					<span>←</span>
					<span>Volver a todos los artículos</span>
				</a>
			</div>
		</div>
	</article>

	<style>
		.article-hero {
			width: 100%;
			max-width: 56rem; /* max-w-4xl = 896px */
			margin: 0 auto;
			text-align: center;
			padding: 1rem 1rem 0;
			box-sizing: border-box;
		}

		.hero-image-wrap {
			margin-bottom: 2rem;
		}

		.featured-image {
			width: 100%;
			max-height: 440px;
			object-fit: cover;
			border-radius: 1.25rem;
			box-shadow: 0 25px 40px -10px rgba(0, 0, 0, 0.7);
			border: 1px solid rgba(255, 255, 255, 0.12);
			display: block;
			margin: 0 auto;
		}

		.breadcrumbs-container {
			margin-bottom: 1.5rem;
			width: 100%;
		}

		.hero-meta {
			margin-bottom: 1.5rem;
		}

		.publication-date-wrapper {
			margin: 0.75rem auto 1.25rem;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.publication-date-pill {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 0.875rem;
			font-weight: 600;
			color: #e5e7eb;
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.12);
			padding: 0.4rem 1.1rem;
			border-radius: 999px;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
		}

		.publication-date-pill svg {
			width: 16px !important;
			height: 16px !important;
			max-width: 16px !important;
			max-height: 16px !important;
			color: #00C988;
			flex-shrink: 0;
		}

		.publication-date-pill strong {
			color: #ffffff;
		}

		.date {
			font-size: 0.95rem;
			color: #9ca3af;
			margin-bottom: 0.75rem;
		}

		.last-updated-on {
			font-style: italic;
			color: #6b7280;
			margin-left: 0.4rem;
		}

		.article-cta-block {
			margin: 2.5rem 0;
		}

		.article-author-block {
			margin: 3.5rem 0;
		}

		.article-related-block {
			margin: 3.5rem 0;
		}

		.article-adsense-bottom-block {
			margin: 3.5rem 0 2.5rem;
		}

		.article-title {
			font-size: 2.75rem;
			line-height: 1.2;
			margin: 0.5rem 0 1.25rem;
			font-weight: 900;
			color: #ffffff;
			letter-spacing: -0.025em;
			text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
		}

		.meta-badges {
			display: flex;
			justify-content: center;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 1rem;
		}

		.category-badge {
			padding: 0.25rem 0.85rem;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.08);
			border: 1px solid rgba(255, 255, 255, 0.12);
			color: #e5e7eb;
			font-weight: 700;
			font-size: 0.8rem;
			text-decoration: none;
			transition: all 0.2s ease;
		}

		.category-badge:hover {
			background: var(--accent);
			color: #0a0a0a;
			border-color: var(--accent);
		}

		.category-badge.badge-noticias {
			background: rgba(37, 99, 235, 0.15);
			color: #93c5fd;
			border: 1px solid rgba(59, 130, 246, 0.4);
		}

		.category-badge.badge-noticias:hover {
			background: #2563eb;
			color: #ffffff;
			border-color: #2563eb;
			box-shadow: 0 0 12px rgba(37, 99, 235, 0.5);
		}

		.badge {
			padding: 0.25rem 0.85rem;
			border-radius: 999px;
			background: rgba(0, 201, 136, 0.15);
			color: #00c988;
			border: 1px solid rgba(0, 201, 136, 0.3);
			font-weight: 700;
			font-size: 0.8rem;
		}

		.badge.badge-noticias {
			background: rgba(239, 68, 68, 0.15);
			color: #f87171;
			border: 1px solid rgba(239, 68, 68, 0.35);
		}

		.author {
			font-size: 0.85rem;
			color: #9ca3af;
			font-weight: 600;
		}

		.hero-cta-wrap {
			margin-top: 1.5rem;
			display: flex;
			justify-content: center;
		}

		.article-content {
			width: 100%;
			max-width: 800px;
			margin: 0 auto;
			padding-bottom: 4rem;
			box-sizing: border-box;
		}

		.prose {
			width: 100%;
			max-width: 100%;
			margin: 0 auto;
			padding: 0;
			color: #d1d5db;
			box-sizing: border-box;
		}

		.prose :global(h2) {
			margin: 2.75rem 0 1rem;
			padding-left: 0.85rem;
			border-left: 4px solid var(--accent);
			line-height: 1.25;
			color: #ffffff;
			font-size: 1.75rem;
			font-weight: 800;
		}

		.prose :global(h3) {
			margin: 2rem 0 0.75rem;
			line-height: 1.3;
			color: #ffffff;
			font-size: 1.35rem;
			font-weight: 700;
		}

		.prose :global(p),
		.prose :global(li) {
			line-height: 1.8;
			color: #d1d5db;
			font-size: 1.05rem;
		}

		.prose :global(ul),
		.prose :global(ol) {
			margin: 1.25rem 0 1.75rem;
			padding-left: 1.75rem;
		}

		.prose :global(li) {
			margin-bottom: 0.6rem;
		}

		.prose :global(blockquote) {
			margin: 2.25rem 0;
			padding: 1.25rem 1.75rem;
			border-left: 4px solid var(--accent);
			border-radius: 0 12px 12px 0;
			background: rgba(255, 255, 255, 0.03);
			font-size: 1.1rem;
			font-style: italic;
			color: #e5e7eb;
		}

		.prose :global(blockquote p) {
			margin: 0;
		}

		.prose :global(img) {
			display: block;
			max-width: 100%;
			height: auto;
			border-radius: 14px;
			box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
			margin: 2.5rem auto;
			border: 1px solid rgba(255, 255, 255, 0.08);
		}

		.prose :global(a:not(.cta-btn):not(.back-btn)) {
			color: var(--accent);
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		/* Sobrescrituras de contraste para el botón inferior de afiliación (cta-faq) */
		.prose :global(a.cta-btn),
		.prose :global(a.cta-btn span) {
			color: #111827 !important; /* text-gray-900 */
			text-decoration: none !important;
		}

		.prose :global(a.cta-btn svg) {
			color: #111827 !important; /* text-gray-900 */
			fill: #111827 !important;
		}

		.prose :global(a.cta-btn:hover),
		.prose :global(a.cta-btn:hover span) {
			color: #000000 !important; /* text-black */
		}

		.prose :global(a.cta-btn:hover svg) {
			color: #000000 !important; /* text-black */
			fill: #000000 !important;
		}

		.prose :global(strong) {
			color: #ffffff;
			font-weight: 700;
		}

		.back-wrap {
			margin-top: 3.5rem;
			padding-top: 2rem;
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			text-align: center;
		}

		.back-btn,
		.prose :global(a.back-btn) {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			padding: 0.85rem 1.8rem;
			border-radius: 999px;
			background: var(--accent);
			color: #111827 !important; /* text-gray-900 */
			font-weight: 800;
			text-decoration: none !important;
			transition:
				transform 0.2s ease,
				box-shadow 0.2s ease,
				color 0.2s ease;
		}

		.back-btn:hover,
		.prose :global(a.back-btn:hover) {
			transform: translateY(-2px);
			box-shadow: 0 8px 20px rgba(0, 201, 136, 0.35);
			color: #000000 !important; /* text-black */
		}

		@media (max-width: 720px) {
			.article-title {
				font-size: 2rem;
			}
			.featured-image {
				max-height: 260px;
			}
		}
	</style>

	<script>
		// Posicionamiento estratégico del bloque AdSense In-Article tras el primer párrafo de contenido
		const inArticleAd = document.getElementById('ad-rotator-in-article');
		if (inArticleAd) {
			const prose = document.querySelector('.prose');
			const firstP = document.querySelector('.prose > p');
			if (firstP && firstP !== inArticleAd && firstP.parentNode) {
				firstP.after(inArticleAd);
			}
		}

		// Inyección dinámica del segundo botón (cta-faq) antes de la sección FAQ con fallback garantizado
		const ctaFaqElement = document.getElementById('cta-faq-wrap') || document.getElementById('cta-faq');
		if (ctaFaqElement) {
			const prose = document.querySelector('.prose');
			const h2s = Array.from(document.querySelectorAll('.prose h2'));
			const faq = h2s.find((h) => /pregunt|faq|duda/i.test(h.textContent || ''));
			if (faq) {
				faq.before(ctaFaqElement);
			} else {
				const authorBlock = document.querySelector('.article-author-block');
				if (authorBlock) {
					authorBlock.before(ctaFaqElement);
				} else {
					const backWrap = document.querySelector('.back-wrap');
					if (backWrap) {
						backWrap.before(ctaFaqElement);
					}
				}
			}
		}
	</script>
</Layout>
