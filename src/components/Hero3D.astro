---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import 'swiper/css/bundle';

interface Props {
	posts?: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

// Se alimenta del array global ya ordenado; en su defecto, extrae y ordena cronológicamente de forma inversa
const allPosts = posts ?? (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);

// Obtenemos y mostramos únicamente los 5 artículos más recientes
const recentPosts = allPosts.slice(0, 5);
---

<div class="hero-3d-container">
	<div class="swiper hero-swiper">
		<div class="swiper-wrapper">
			{
				recentPosts.map((post) => (
					<div class="swiper-slide hero-slide">
						<a href={`/blog/${post.id}/`} class="slide-link" aria-label={`Leer artículo: ${post.data.title}`}>
							{post.data.heroImage && (
								<img
									src={post.data.heroImage}
									alt={post.data.title}
									class="slide-bg-img"
									loading="eager"
								/>
							)}
							<div class="slide-overlay bg-black/40">
								<div class="slide-meta">
									{post.data.category && (
										<span class:list={['slide-category', { 'category-noticias': post.data.category === 'Noticias' }]}>
											{post.data.category}
										</span>
									)}
									<span class="slide-badge">⚡ Destacado</span>
								</div>
								<h3 class="slide-title">{post.data.title}</h3>
								<span class="slide-action">Leer guía completa →</span>
							</div>
						</a>
					</div>
				))
			}
		</div>
		<div class="swiper-pagination"></div>
	</div>
</div>

<script>
	import Swiper from 'swiper/bundle';

	function initHeroSwiper() {
		const swiperEl = document.querySelector('.hero-swiper');
		if (!swiperEl) return;

		new Swiper(swiperEl as HTMLElement, {
			effect: 'coverflow',
			grabCursor: true,
			centeredSlides: true,
			slidesPerView: 'auto',
			loop: true,
			speed: 800,
			autoplay: {
				delay: 3500,
				disableOnInteraction: false,
				pauseOnMouseEnter: true,
			},
			coverflowEffect: {
				rotate: 22,
				stretch: 0,
				depth: 220,
				modifier: 1,
				slideShadows: true,
			},
			pagination: {
				el: '.swiper-pagination',
				clickable: true,
				dynamicBullets: true,
			},
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHeroSwiper);
	} else {
		initHeroSwiper();
	}
</script>

<style>
	.hero-3d-container {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto 2.5rem;
		padding: 1rem 0 2rem;
		overflow: hidden;
		position: relative;
	}

	.hero-swiper {
		width: 100%;
		padding-top: 1.5rem;
		padding-bottom: 3.5rem;
		overflow: visible !important;
	}

	.hero-slide {
		width: 520px;
		max-width: 85vw;
		height: 330px;
		border-radius: 1.25rem;
		overflow: hidden;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 25px 40px -10px rgba(0, 0, 0, 0.7);
		transition: border-color 0.3s ease;
	}

	.hero-slide:hover {
		border-color: rgba(0, 201, 136, 0.6);
	}

	.slide-link {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		overflow: hidden;
	}

	.slide-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero-slide:hover .slide-bg-img {
		transform: scale(1.06);
	}

	.slide-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.15) 0%,
			rgba(0, 0, 0, 0.45) 45%,
			rgba(10, 10, 10, 0.95) 100%
		);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 1.75rem;
		box-sizing: border-box;
		backdrop-filter: blur(2px);
	}

	.slide-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.6rem;
		flex-wrap: wrap;
	}

	.slide-category {
		background: rgba(0, 201, 136, 0.2);
		color: #00c988;
		border: 1px solid rgba(0, 201, 136, 0.4);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.slide-category.category-noticias {
		background: rgba(37, 99, 235, 0.25);
		color: #93c5fd;
		border-color: rgba(59, 130, 246, 0.5);
	}

	.slide-badge {
		background: rgba(255, 255, 255, 0.1);
		color: #e5e7eb;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.slide-title {
		margin: 0 0 0.5rem;
		font-size: 1.35rem;
		line-height: 1.3;
		font-weight: 800;
		color: #ffffff;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.slide-action {
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: transform 0.2s ease;
	}

	.hero-slide:hover .slide-action {
		transform: translateX(4px);
	}

	:global(.hero-swiper .swiper-pagination-bullet) {
		background: rgba(255, 255, 255, 0.35) !important;
		opacity: 0.6 !important;
		transition: all 0.3s ease !important;
		width: 8px !important;
		height: 8px !important;
	}

	:global(.hero-swiper .swiper-pagination-bullet-active) {
		background: #00c988 !important;
		opacity: 1 !important;
		width: 24px !important;
		border-radius: 999px !important;
		box-shadow: 0 0 12px rgba(0, 201, 136, 0.8) !important;
	}

	:global(.swiper-3d .swiper-slide-shadow-left),
	:global(.swiper-3d .swiper-slide-shadow-right) {
		background-image: linear-gradient(
			to right,
			rgba(10, 10, 10, 0.8),
			rgba(10, 10, 10, 0)
		) !important;
		border-radius: 1.25rem !important;
	}

	@media (max-width: 640px) {
		.hero-slide {
			width: 290px;
			height: 250px;
			border-radius: 1rem;
		}
		.slide-overlay {
			padding: 1.1rem;
		}
		.slide-title {
			font-size: 1.1rem;
		}
		.slide-action {
			font-size: 0.8rem;
		}
	}
</style>
