---
/**
 * Componente: ArticulosRelacionados.astro
 * Distribuye link juice interno y retiene al lector mostrando artículos relevantes
 * de la misma categoría o temática afín.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	categoria?: string;
	currentSlug?: string;
	maxPosts?: number;
	className?: string;
}

const {
	categoria = 'General',
	currentSlug = '',
	maxPosts = 3,
	className = '',
} = Astro.props;

function slugify(text: string): string {
	return text
		.toLowerCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
}

const currentCatSlug = slugify(categoria);

// 1. Obtener todos los artículos de la colección
const allPosts = await getCollection('blog');

// 2. Excluir el artículo actual
const otherPosts = allPosts.filter((post) => {
	const pid = post.id.replace(/^\/+|\/+$/g, '');
	const current = currentSlug.replace(/^\/+|\/+$/g, '');
	return pid !== current;
});

// 3. Filtrar artículos de la misma categoría (o slug de categoría coincidente)
const sameCatPosts = otherPosts.filter((post) => {
	const postCat = post.data.category || 'General';
	return slugify(postCat) === currentCatSlug;
});

// Ordenar por fecha descendente (más recientes primero)
sameCatPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 4. Si hay menos de maxPosts, rellenar con otros artículos recientes para evitar huecos
let finalRelated: CollectionEntry<'blog'>[] = [];
if (sameCatPosts.length >= maxPosts) {
	finalRelated = sameCatPosts.slice(0, maxPosts);
} else {
	finalRelated = [...sameCatPosts];
	const existingIds = new Set(finalRelated.map((p) => p.id));
	const fallbackPosts = otherPosts
		.filter((p) => !existingIds.has(p.id))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	finalRelated.push(...fallbackPosts.slice(0, maxPosts - finalRelated.length));
}
---

{
	finalRelated.length > 0 && (
		<section
			class={`articulos-relacionados ${className}`}
			aria-label="Artículos relacionados"
		>
			<div class="related-header">
				<h3 class="related-title">
					<span class="related-title-indicator"></span>
					<span>Artículos Relacionados {categoria ? `de ${categoria}` : ''}</span>
				</h3>
				{categoria && (
					<a
						href={`/categoria/${currentCatSlug}`}
						class="see-more-link"
					>
						<span>Ver más en {categoria}</span>
						<svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
						</svg>
					</a>
				)}
			</div>

			<div class="related-grid">
				{finalRelated.map((post) => {
					const postUrl = `/blog/${post.id}`;
					const imgUrl = post.data.heroImage || '/favicon.svg';
					const catName = post.data.category || categoria;

					return (
						<article class="related-card">
							<a href={postUrl} class="card-image-wrap" tabindex="-1" aria-hidden="true">
								<img
									src={imgUrl}
									alt={post.data.title}
									loading="lazy"
									decoding="async"
									class="card-image"
								/>
								<span class="card-badge">
									{catName}
								</span>
							</a>

							<div class="card-body">
								<div class="card-content-top">
									<div class="card-date">
										<FormattedDate date={post.data.pubDate} />
									</div>

									<h4 class="card-title">
										<a href={postUrl}>
											{post.data.title}
										</a>
									</h4>
								</div>

								<a href={postUrl} class="card-footer">
									<span>Leer artículo</span>
									<svg class="card-arrow" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
										<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
									</svg>
								</a>
							</div>
						</article>
					);
				})}
			</div>
		</section>
	)
}

<style>
	.articulos-relacionados {
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		width: 100%;
		box-sizing: border-box;
	}

	.related-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.related-title {
		font-size: 1.35rem !important;
		font-weight: 800 !important;
		color: #ffffff !important;
		display: flex !important;
		align-items: center !important;
		gap: 0.6rem !important;
		margin: 0 !important;
		padding: 0 !important;
		border: none !important;
		line-height: 1.25 !important;
	}

	.related-title-indicator {
		display: inline-block;
		width: 4px;
		height: 22px;
		border-radius: 999px;
		background: #00C988;
		flex-shrink: 0;
	}

	.see-more-link {
		font-size: 0.85rem;
		font-weight: 600;
		color: #00C988;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: color 0.15s ease;
	}

	.see-more-link:hover {
		color: #ffffff;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		width: 100%;
		box-sizing: border-box;
	}

	@media (max-width: 640px) {
		.related-grid {
			grid-template-columns: 1fr;
		}
	}

	.related-card {
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 1rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
		text-align: left;
		box-sizing: border-box;
	}

	.related-card:hover {
		transform: translateY(-4px);
		border-color: rgba(0, 201, 136, 0.4);
		box-shadow: 0 12px 25px rgba(0, 0, 0, 0.5);
	}

	.card-image-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #1c1c1c;
		display: block;
	}

	.card-image {
		width: 100% !important;
		height: 100% !important;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		display: block;
		margin: 0 !important;
		padding: 0 !important;
		border: none !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		transition: transform 0.4s ease;
	}

	.related-card:hover .card-image {
		transform: scale(1.05);
	}

	.card-badge {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 700;
		background: rgba(10, 10, 10, 0.8);
		backdrop-filter: blur(8px);
		color: #00C988;
		border: 1px solid rgba(255, 255, 255, 0.15);
		text-transform: capitalize;
		z-index: 2;
		line-height: 1.2;
	}

	.card-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		justify-content: space-between;
		gap: 0.85rem;
		box-sizing: border-box;
	}

	.card-date {
		font-size: 0.75rem;
		color: #9ca3af;
		font-weight: 500;
		margin-bottom: 0.4rem;
	}

	.card-title {
		font-size: 0.975rem !important;
		font-weight: 700 !important;
		color: #ffffff !important;
		line-height: 1.4 !important;
		margin: 0 !important;
		padding: 0 !important;
		border: none !important;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-title a {
		color: #ffffff !important;
		text-decoration: none !important;
		transition: color 0.15s ease;
	}

	.related-card:hover .card-title a {
		color: #00C988 !important;
	}

	.card-footer {
		padding-top: 0.75rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.8rem;
		font-weight: 600;
		color: #9ca3af;
		text-decoration: none !important;
		transition: color 0.15s ease;
	}

	.related-card:hover .card-footer {
		color: #00C988;
	}

	.card-arrow {
		transition: transform 0.2s ease;
	}

	.related-card:hover .card-arrow {
		transform: translateX(4px);
	}

	/* Restricción estricta de SVG */
	.articulos-relacionados svg {
		width: 16px !important;
		height: 16px !important;
		max-width: 16px !important;
		max-height: 16px !important;
		min-width: 16px !important;
		min-height: 16px !important;
		flex-shrink: 0 !important;
		display: inline-block !important;
		vertical-align: middle !important;
	}
</style>
