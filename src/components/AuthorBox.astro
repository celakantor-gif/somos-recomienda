---
/**
 * Componente: AuthorBox.astro
 * Caja de Autor profesional para reforzar señales de autoridad y confianza (E-E-A-T)
 * conforme a las directrices de calidad de Google Search Quality Rater.
 */
interface Props {
	authorName?: string;
	authorRole?: string;
	authorBio?: string;
	className?: string;
}

const {
	authorName = 'Redacción Recomendación',
	authorRole = 'Equipo Editorial & Análisis de Producto',
	authorBio = 'Especialistas en análisis técnico, comparativas y pruebas de producto para guías de compra independientes.',
	className = '',
} = Astro.props;
---

<aside
	class={`author-box ${className}`}
	aria-label="Información del autor"
>
	<div class="author-avatar-wrap">
		<div class="author-avatar-gradient">
			<div class="author-avatar-inner">
				<svg class="author-avatar-icon" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
				</svg>
			</div>
		</div>
	</div>

	<div class="author-details">
		<div class="author-header">
			<h3 class="author-name">
				{authorName}
			</h3>
			<span class="author-badge">
				<svg class="badge-icon" width="12" height="12" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
					<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
				</svg>
				Verificado E-E-A-T
			</span>
		</div>

		<p class="author-role">
			{authorRole}
		</p>

		<p class="author-bio">
			{authorBio}
		</p>
	</div>
</aside>

<style>
	.author-box {
		margin: 3rem 0;
		padding: 1.5rem;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 1rem;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 1.25rem;
		text-align: left;
		box-sizing: border-box;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.author-box:hover {
		border-color: rgba(255, 255, 255, 0.2);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
	}

	.author-avatar-wrap {
		flex-shrink: 0;
	}

	.author-avatar-gradient {
		width: 64px;
		height: 64px;
		min-width: 64px;
		min-height: 64px;
		border-radius: 50%;
		background: linear-gradient(135deg, #059669 0%, #00C988 100%);
		padding: 2px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 12px rgba(0, 201, 136, 0.25);
		box-sizing: border-box;
	}

	.author-avatar-inner {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: #181818;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #00C988;
	}

	.author-avatar-icon {
		width: 32px !important;
		height: 32px !important;
		max-width: 32px !important;
		max-height: 32px !important;
		flex-shrink: 0 !important;
		display: block;
	}

	.author-details {
		flex: 1;
		min-width: 0;
	}

	.author-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.25rem;
	}

	.author-name {
		font-size: 1.15rem !important;
		font-weight: 800 !important;
		color: #ffffff !important;
		margin: 0 !important;
		padding: 0 !important;
		border: none !important;
		line-height: 1.3 !important;
	}

	.author-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		font-size: 0.725rem;
		font-weight: 700;
		background: rgba(0, 201, 136, 0.12);
		color: #00C988;
		border: 1px solid rgba(0, 201, 136, 0.3);
		line-height: 1;
	}

	.badge-icon {
		width: 12px !important;
		height: 12px !important;
		max-width: 12px !important;
		max-height: 12px !important;
		flex-shrink: 0 !important;
	}

	.author-role {
		font-size: 0.75rem !important;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #9ca3af !important;
		font-weight: 600;
		margin: 0 0 0.5rem 0 !important;
		line-height: 1.4 !important;
	}

	.author-bio {
		font-size: 0.925rem !important;
		color: #d1d5db !important;
		line-height: 1.6 !important;
		margin: 0 !important;
	}

	@media (max-width: 640px) {
		.author-box {
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 1.25rem;
		}

		.author-header {
			justify-content: center;
		}
	}
</style>
