---
import { getCollection, type CollectionEntry } from 'astro:content';
import 'swiper/css/bundle';

interface Props {
	category: string;
}

export function slugifyCategory(cat: string): string {
	return cat
		.toLowerCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
}

const { category } = Astro.props;

// Extracción y filtrado interno por categoría exacta
const allPosts = await getCollection('blog');
const targetSlug = slugifyCategory(category || '');

const matchingPosts = allPosts
	.filter((post) => {
		const rawCat = post.data.category || '';
		const s = slugifyCategory(rawCat);
		if (targetSlug === 'consejos') {
			return s !== 'noticias' && s !== 'economia' && s !== 'deportes' && s !== 'salud';
		}
		return rawCat === category || s === targetSlug;
	})
	.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// Recortamos entre 3 y 5 artículos (mostrando los que haya si son menos de 3)
const carouselPosts: CollectionEntry<'blog'>[] = matchingPosts.slice(0, 5);
---

{
	carouselPosts.length > 0 && (
		<div class="category-carousel-container">
			<div class="swiper category-swiper">
				<div class="swiper-wrapper">
					{carouselPosts.map((post) => (
						<div class="swiper-slide category-slide">
							<a
								href={`/blog/${post.id}/`}
								class="slide-link"
								aria-label={`Leer artículo: ${post.data.title}`}
							>
								{post.data.heroImage && (
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										class="slide-bg-img"
										loading="lazy"
									/>
								)}
								<div class="slide-overlay">
									<div class="slide-meta">
										{post.data.category && (
											<span
												class:list={[
													'slide-category',
													{ 'category-noticias': post.data.category === 'Noticias' },
												]}
											>
												{post.data.category}
											</span>
										)}
										<span class="slide-badge">⚡ Destacado</span>
									</div>
									<h3 class="slide-title">{post.data.title}</h3>
									<span class="slide-action">Leer artículo completo →</span>
								</div>
							</a>
						</div>
					))}
				</div>
				<div class="swiper-pagination"></div>
			</div>
		</div>
	)
}

<script>
	import Swiper from 'swiper/bundle';

	function initCategorySwipers() {
		const swiperEls = document.querySelectorAll('.category-swiper');
		swiperEls.forEach((el) => {
			if ((el as any).swiper) return;

			const slides = el.querySelectorAll('.swiper-slide');
			const slideCount = slides.length;
			if (slideCount === 0) return;

			// Si hay menos de 3 diapositivas, no forzamos loop para evitar duplicidades innecesarias
			const canLoop = slideCount >= 3;

			new Swiper(el as HTMLElement, {
				effect: canLoop ? 'coverflow' : 'slide',
				grabCursor: true,
				centeredSlides: canLoop,
				slidesPerView: 'auto',
				loop: canLoop,
				speed: 800,
				autoplay:
					slideCount > 1
						? {
								delay: 3800,
								disableOnInteraction: false,
								pauseOnMouseEnter: true,
							}
						: false,
				coverflowEffect: {
					rotate: 20,
					stretch: 0,
					depth: 200,
					modifier: 1,
					slideShadows: true,
				},
				pagination: {
					el: el.querySelector('.swiper-pagination') as HTMLElement,
					clickable: true,
					dynamicBullets: true,
				},
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initCategorySwipers);
	} else {
		initCategorySwipers();
	}
</script>

<style>
	.category-carousel-container {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto 3rem;
		padding: 0.5rem 0 1.5rem;
		overflow: hidden;
		position: relative;
	}

	.category-swiper {
		width: 100%;
		padding-top: 1rem;
		padding-bottom: 3rem;
		overflow: visible !important;
	}

	.category-slide {
		width: 480px;
		max-width: 85vw;
		height: 300px;
		border-radius: 1.25rem;
		overflow: hidden;
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 25px 40px -10px rgba(0, 0, 0, 0.7);
		transition: border-color 0.3s ease, transform 0.3s ease;
	}

	.category-slide:hover {
		border-color: rgba(0, 201, 136, 0.6);
	}

	.slide-link {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		overflow: hidden;
	}

	.slide-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.category-slide:hover .slide-bg-img {
		transform: scale(1.05);
	}

	.slide-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.1) 0%,
			rgba(0, 0, 0, 0.5) 45%,
			rgba(10, 10, 10, 0.95) 100%
		);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 1.5rem;
		box-sizing: border-box;
		backdrop-filter: blur(2px);
	}

	.slide-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}

	.slide-category {
		background: rgba(0, 201, 136, 0.2);
		color: #00c988;
		border: 1px solid rgba(0, 201, 136, 0.4);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.slide-category.category-noticias {
		background: rgba(37, 99, 235, 0.25);
		color: #93c5fd;
		border-color: rgba(59, 130, 246, 0.5);
	}

	.slide-badge {
		background: rgba(255, 255, 255, 0.1);
		color: #e5e7eb;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.slide-title {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
		line-height: 1.35;
		font-weight: 800;
		color: #ffffff;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.slide-action {
		color: var(--accent, #00c988);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: transform 0.2s ease;
	}

	.category-slide:hover .slide-action {
		transform: translateX(4px);
	}

	:global(.category-swiper .swiper-pagination-bullet) {
		background: rgba(255, 255, 255, 0.35) !important;
		opacity: 0.6 !important;
		transition: all 0.3s ease !important;
		width: 8px !important;
		height: 8px !important;
	}

	:global(.category-swiper .swiper-pagination-bullet-active) {
		background: #00c988 !important;
		opacity: 1 !important;
		width: 24px !important;
		border-radius: 999px !important;
		box-shadow: 0 0 12px rgba(0, 201, 136, 0.8) !important;
	}

	@media (max-width: 640px) {
		.category-slide {
			width: 290px;
			height: 240px;
			border-radius: 1rem;
		}
		.slide-overlay {
			padding: 1rem;
		}
		.slide-title {
			font-size: 1.05rem;
		}
		.slide-action {
			font-size: 0.8rem;
		}
	}
</style>
